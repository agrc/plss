{
  "name": "@ugrc/plss-app",
  "version": "3.6.17-rc.1",
  "private": true,
  "description": "A React app for the UGRC PLSS",
  "license": "MIT",
  "author": "UGRC",
  "type": "module",
  "main": "./src/functions/index.mjs",
  "scripts": {
    "build": "pnpm check && vite build",
    "build-storybook": "storybook build",
    "check": "tsc -b",
    "cm": "cz",
    "copy:arcgis": "cpy \"./node_modules/@arcgis/core/assets/**\" ./public/assets",
    "coverage": "vitest run --coverage",
    "dev": "cross-env NODE_ENV=development concurrently 'wait-on http://127.0.0.1:4000 && pnpm dev:vite' 'pnpm dev:firebase'",
    "dev:firebase": "pnpm --filter functions build && cross-env NODE_ENV=development firebase emulators:start --import .emulator-data --only auth,functions,firestore,storage",
    "dev:firebase-state": "pnpm --filter functions build && cross-env NODE_ENV=development concurrently 'firebase emulators:start --import=.emulator-data --export-on-exit=.emulator-data --only auth,functions,firestore,storage' 'pnpm dev:vite'",
    "dev:vite": "vite",
    "fb:deploy": "firebase deploy --only functions",
    "fb:serve": "pnpm --filter functions build && cross-env NODE_ENV=development firebase emulators:start --only functions",
    "format": "prettier . --write",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "save-firebase-state": "cross-env NODE_ENV=development firebase emulators:start --import .emulator-data --export-on-exit --only auth,functions,firestore,storage",
    "start": "pnpm dev",
    "storybook": "storybook dev -p 6006",
    "pretest": "pnpm --filter @ugrc/plss-shared build",
    "test": "vitest --silent --coverage --ui --open",
    "test:ci": "firebase emulators:exec --only storage 'pnpm test'"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": "eslint --cache --fix",
    "*.{md,yml,yaml,json}": "prettier --write"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@arcgis/core": "5.1.15",
    "@arcgis/map-components": "5.1.15",
    "@esri/calcite-components": "^5.1.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.7.1",
    "@react-hook/window-size": "^3.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@ugrc/plss-shared": "workspace:*",
    "@ugrc/utah-design-system": "^4.1.0",
    "@ugrc/utilities": "^5.0.1",
    "@xstate/react": "^6.1.0",
    "camelcase": "^9.0.0",
    "clsx": "^2.1.1",
    "contrast-color": "^1.0.1",
    "cors": "^2.8.6",
    "dms-conversion": "^3.1.4",
    "firebase": "^12.17.1",
    "if-env": "^1.0.4",
    "immer": "^11.1.16",
    "ky": "^2.0.2",
    "md5": "^2.3.0",
    "natural-orderby": "^5.0.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.84.0",
    "react-stately": "^3.49.0",
    "use-immer": "^0.11.0",
    "xstate": "^5.32.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@hookform/devtools": "^4.4.0",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-links": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/contrast-color": "1.0.3",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.4",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/tsconfigs": "1.0.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.4",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^15.26.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "24"
  }
}
