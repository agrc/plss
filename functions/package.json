{
  "name": "functions",
  "private": true,
  "description": "Cloud Functions for Firebase",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "pnpm run clean && pnpm --filter @ugrc/plss-shared build && tsc -p tsconfig.build.json && cp -R fonts lib/fonts",
    "clean": "rm -rf lib",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint ./ --ext .js --ignore-path ../.eslintignore",
    "logs": "firebase functions:log",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "format": "prettier \"src/**/*.{js,jsx,ts,json,mjs,md,mdx}\" --write",
    "start": "pnpm run shell",
    "test": "vitest --silent --coverage --ui --open"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@sendgrid/client": "^8.1.6",
    "@ugrc/plss-shared": "file:shared",
    "base64-stream": "^1.0.0",
    "contrast-color": "^1.0.1",
    "dms-conversion": "^3.1.4",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "googleapis": "^174.0.1",
    "ky": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "uuid": "^14.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/base64-stream": "1.0.5",
    "@types/contrast-color": "1.0.3",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "eslintConfig": {
    "env": {
      "es2022": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "plugins": [
      "prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": true
  },
  "engines": {
    "node": "24"
  }
}
