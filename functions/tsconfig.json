{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "outDir": "lib",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "target": "ES2024",
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.functions.tsbuildinfo"
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["**/*.test.js", "lib", "node_modules"]
}
